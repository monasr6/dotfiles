# =============================================================================
# Enable Powerlevel10k instant prompt — MUST stay at the very top
# =============================================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =============================================================================
# PATH
# =============================================================================
export PATH="$HOME/.local/bin:/usr/local/go/bin:/usr/local/bin:$PATH"

# =============================================================================
# Environment Variables
# =============================================================================
export ZSH="$HOME/.oh-my-zsh"
export DEFAULT_USER=$USER
export LANG="en_US.UTF-8"

# Editor: prefer nvim, fall back to vim
if command -v nvim &>/dev/null; then
  export EDITOR="nvim"
else
  export EDITOR="vim"
fi
export VISUAL="$EDITOR"

# Secrets — never commit this file (chmod 600, not tracked by git)
[[ -f ~/.zsh_secrets ]] && source ~/.zsh_secrets

# =============================================================================
# Oh My Zsh Theme
# =============================================================================
ZSH_THEME="powerlevel10k/powerlevel10k"
ZSH_DISABLE_COMPFIX="true"

# =============================================================================
# Oh My Zsh Plugins
# (zsh-autosuggestions, zsh-syntax-highlighting, history-substring-search
#  are symlinked from ~/.zsh/ into ~/.oh-my-zsh/custom/plugins/)
# =============================================================================
plugins=(
  git
  docker
  kubectl
  zsh-autosuggestions
  zsh-syntax-highlighting
  history-substring-search
)

# =============================================================================
# Completion — OMZ handles compinit; we just tune it here
# =============================================================================
# Rebuild .zcompdump at most once a day (huge speed gain)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit                  # full check once a day
else
  compinit -C               # skip security check the rest of the time
fi

# =============================================================================
# History
# =============================================================================
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt appendhistory        # append rather than overwrite history
setopt sharehistory         # share history across all terminals
setopt hist_ignore_dups     # skip duplicate consecutive entries
setopt hist_ignore_space    # don't save commands starting with a space
setopt hist_verify          # show substituted history before executing

# =============================================================================
# Source Oh My Zsh
# =============================================================================
source $ZSH/oh-my-zsh.sh

# =============================================================================
# Keybindings
# =============================================================================
# Ctrl+R → fzf full interactive history search
bindkey '^R' fzf-history-widget

# Arrow keys → history-substring-search (type prefix, then ↑/↓)
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# =============================================================================
# Completion Tweaks
# =============================================================================
# Case-insensitive tab completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# =============================================================================
# Shell Options
# =============================================================================
setopt correct              # suggest corrections for mistyped commands

# =============================================================================
# Auto-suggestions style
# =============================================================================
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=cyan'
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# =============================================================================
# FZF
# =============================================================================
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# =============================================================================
# Autojump (j <dir>)
# =============================================================================
[[ -f /home/ctrl/.autojump/etc/profile.d/autojump.sh ]] && \
  source /home/ctrl/.autojump/etc/profile.d/autojump.sh

# =============================================================================
# NVM — lazy-loaded for fast shell startup (~300ms saved)
# =============================================================================
export NVM_DIR="$HOME/.nvm"
# Only load nvm when first called (nvm, node, npm, npx)
nvm() {
  unfunction nvm node npm npx 2>/dev/null
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  nvm "$@"
}
node() { nvm use default >/dev/null 2>&1; node "$@"; }
npm()  { nvm use default >/dev/null 2>&1; npm  "$@"; }
npx()  { nvm use default >/dev/null 2>&1; npx  "$@"; }

# =============================================================================
# Deno
# =============================================================================
[[ -f "/home/ctrl/.deno/env" ]] && . "/home/ctrl/.deno/env"

# =============================================================================
# Git Aliases
# =============================================================================
alias gs='git status'
alias gl='git pull'
alias gp='git push'
alias gf='git fetch --all --prune'
alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit --amend --no-edit'
alias glog='git log --oneline --graph --decorate'
alias glog2='git log --graph --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit'
alias gco='git checkout'
alias ggg='git checkout -b'
alias gd='git diff'
alias gds='git diff --staged'
alias grb='git rebase'
alias grbi='git rebase -i'
alias gst='git stash'
alias gstp='git stash pop'
alias gclean='git branch --merged | grep -v "\*\|main\|master\|development" | xargs -r git branch -d'

# =============================================================================
# General Aliases
# =============================================================================
alias ls='lsd'
alias ll='lsd -lA'
alias lt='lsd --tree --depth 2'
alias r='ranger'
alias lzd='lazydocker'
alias mktest='make test_local_lite'
alias zreload='source ~/.zshrc && echo "✅ .zshrc reloaded"'
alias zedit='${EDITOR:-vim} ~/dotfiles/zsh/zshrc'
alias dsync='cd ~/dotfiles && git add -A && git commit -m "chore: sync dotfiles $(date +%Y-%m-%d)" && git push && cd -'

# System
alias ports='ss -tulnp'
alias myip='curl -s ifconfig.me && echo'
alias path='echo $PATH | tr ":" "\n"'
alias df='df -h'
alias du='du -sh'

# Python / Django shortcuts
alias py='python'
alias py3='python3'
alias pip='pip3'
alias act='source .venv/bin/activate 2>/dev/null || source venv/bin/activate 2>/dev/null || echo "No venv found"'
alias djrun='python manage.py runserver'
alias djmig='python manage.py migrate'
alias djmkm='python manage.py makemigrations'
alias djsh='python manage.py shell_plus'

# Docker shortcuts
alias dps='docker ps'
alias dpsa='docker ps -a'
alias dimg='docker images'
alias dlog='docker logs -f'
alias dex='docker exec -it'
alias dcu='docker compose up -d'
alias dcd='docker compose down'
alias dcr='docker compose restart'
alias dcl='docker compose logs -f'

# =============================================================================
# Stored in ~/.zsh_work — NOT committed to git (chmod 600, machine-local)
# =============================================================================
[[ -f ~/.zsh_work ]] && source ~/.zsh_work

# =============================================================================
# Useful Functions
# =============================================================================

# mkcd: create directory and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# extract: universal archive extractor
extract() {
  case "$1" in
    *.tar.gz|*.tgz)  tar xzf "$1" ;;
    *.tar.bz2|*.tbz) tar xjf "$1" ;;
    *.tar.xz)        tar xJf "$1" ;;
    *.zip)           unzip "$1" ;;
    *.gz)            gunzip "$1" ;;
    *.bz2)           bunzip2 "$1" ;;
    *.rar)           unrar x "$1" ;;
    *)               echo "Unknown archive format: $1" ;;
  esac
}

# ghpr: open current branch's GitHub PR in browser
ghpr() {
  local repo_url
  repo_url=$(git remote get-url origin 2>/dev/null | sed 's/git@github.com:/https:\/\/github.com\//; s/\.git$//')
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  [[ -n "$repo_url" && -n "$branch" ]] && xdg-open "$repo_url/compare/$branch" || echo "Not a git repo or no remote"
}

# port: check what's listening on a port
port() { ss -tulnp | grep ":$1"; }

# =============================================================================
# Powerlevel10k — must stay at the bottom
# =============================================================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
